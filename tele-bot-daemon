#!/usr/bin/env python3
import os
import sys
import time
import subprocess
import urllib.request
import urllib.parse
import json
import re
import glob
from datetime import datetime

CONFIG_PATHS = [
    os.path.expanduser("~/.telegram_config"),
    os.path.expanduser("~/.env"),
    ".env"
]
LOG_PATH = "/var/log/telegram-notifier.log"
FALLBACK_LOG_PATH = os.path.expanduser("~/.telegram_notifier.log")

# Global state for session
session_cwd = os.path.expanduser("~")
shell_mode = False

def strip_ansi(text):
    return re.sub(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])', '', text)

def escape_html(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

def load_config():
    bot_token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat_id = os.environ.get("TELEGRAM_CHAT_ID")

    for path in CONFIG_PATHS:
        if os.path.exists(path):
            try:
                with open(path, "r") as f:
                    for line in f:
                        line = line.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            k, v = k.strip(), v.strip().strip('"').strip("'")
                            if k == "TELEGRAM_BOT_TOKEN" and not bot_token:
                                bot_token = v
                            elif k == "TELEGRAM_CHAT_ID" and not chat_id:
                                chat_id = v
            except Exception:
                pass

    return bot_token, chat_id

def send_message(bot_token, chat_id, text, reply_markup=None):
    url = f"https://api.telegram.org/bot{bot_token}/sendMessage"
    payload = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": "HTML",
        "disable_web_page_preview": True
    }
    if reply_markup:
        payload["reply_markup"] = reply_markup

    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as response:
            return json.loads(response.read().decode("utf-8"))
    except Exception as e:
        print(f"Error sending message: {e}", file=sys.stderr)
        return None

def send_document(bot_token, chat_id, file_path, caption=""):
    url = f"https://api.telegram.org/bot{bot_token}/sendDocument"
    if not os.path.exists(file_path):
        send_message(bot_token, chat_id, f"❌ File tidak ditemukan: <code>{file_path}</code>")
        return False

    boundary = "----WebKitFormBoundary7MA4YWxkTrZu0gW"
    filename = os.path.basename(file_path)

    try:
        with open(file_path, "rb") as f:
            file_content = f.read()

        body = []
        body.append(f"--{boundary}".encode("utf-8"))
        body.append(f'Content-Disposition: form-data; name="chat_id"'.encode("utf-8"))
        body.append(b"")
        body.append(str(chat_id).encode("utf-8"))

        if caption:
            body.append(f"--{boundary}".encode("utf-8"))
            body.append(f'Content-Disposition: form-data; name="caption"'.encode("utf-8"))
            body.append(b"")
            body.append(caption.encode("utf-8"))

        body.append(f"--{boundary}".encode("utf-8"))
        body.append(f'Content-Disposition: form-data; name="document"; filename="{filename}"'.encode("utf-8"))
        body.append(b"Content-Type: application/octet-stream")
        body.append(b"")
        body.append(file_content)

        body.append(f"--{boundary}--".encode("utf-8"))
        body.append(b"")

        payload = b"\r\n".join(body)

        req = urllib.request.Request(
            url,
            data=payload,
            headers={"Content-Type": f"multipart/form-data; boundary={boundary}"}
        )

        with urllib.request.urlopen(req, timeout=30) as response:
            res = json.loads(response.read().decode("utf-8"))
            return res.get("ok", False)
    except Exception as e:
        send_message(bot_token, chat_id, f"❌ Gagal mengirim dokumen: {e}")
        return False

def download_telegram_file(bot_token, file_id, save_destination):
    try:
        # 1. Get file path from Telegram API
        get_file_url = f"https://api.telegram.org/bot{bot_token}/getFile?file_id={file_id}"
        req = urllib.request.Request(get_file_url)
        with urllib.request.urlopen(req, timeout=10) as response:
            res = json.loads(response.read().decode("utf-8"))
            if not res.get("ok"):
                return False, f"Telegram API error: {res}"
            tele_file_path = res["result"]["file_path"]

        # 2. Download file content
        download_url = f"https://api.telegram.org/file/bot{bot_token}/{tele_file_path}"
        req_dl = urllib.request.Request(download_url)
        with urllib.request.urlopen(req_dl, timeout=30) as dl_resp:
            content = dl_resp.read()

        # 3. Ensure target parent directory exists and write
        parent_dir = os.path.dirname(save_destination)
        if parent_dir and not os.path.exists(parent_dir):
            os.makedirs(parent_dir, exist_ok=True)

        with open(save_destination, "wb") as f:
            f.write(content)

        return True, f"File berhasil disimpan ke <code>{save_destination}</code> ({len(content)} bytes)."
    except Exception as e:
        return False, f"Gagal mengunduh file: {e}"

def send_chunked_output(bot_token, chat_id, header, output_text):
    clean = strip_ansi(output_text)
    escaped = escape_html(clean)
    
    max_len = 3800
    if len(escaped) <= max_len:
        msg = f"{header}\n<pre><code>{escaped}</code></pre>"
        send_message(bot_token, chat_id, msg)
    else:
        chunks = [escaped[i:i+max_len] for i in range(0, len(escaped), max_len)]
        send_message(bot_token, chat_id, f"{header} (Part 1/{len(chunks)}):")
        for idx, chunk in enumerate(chunks):
            send_message(bot_token, chat_id, f"<pre><code>{chunk}</code></pre>")

def get_logs(limit=10):
    path = LOG_PATH if os.path.exists(LOG_PATH) else FALLBACK_LOG_PATH
    if not os.path.exists(path):
        return "<i>Belum ada log notifikasi yang tercatat.</i>"

    try:
        with open(path, "r", encoding="utf-8") as f:
            lines = f.readlines()
            recent = lines[-limit:] if len(lines) > limit else lines
            if not recent:
                return "<i>Log kosong.</i>"
            
            output = "<b>📜 Riwayat Log Notifikasi (Terbaru):</b>\n\n"
            for l in recent:
                safe_l = escape_html(l.strip())
                output += f"<code>{safe_l}</code>\n\n"
            return output
    except Exception as e:
        return f"Gagal membaca log: {e}"

def get_system_status():
    try:
        uptime = subprocess.check_output(["uptime", "-p"]).decode().strip()
        free_out = subprocess.check_output(["free", "-h"]).decode()
        mem_line = [line for line in free_out.splitlines() if line.startswith("Mem:")][0].split()
        mem_total, mem_used, mem_avail = mem_line[1], mem_line[2], mem_line[6]

        df_out = subprocess.check_output(["df", "-h", "/"]).decode()
        disk_line = df_out.splitlines()[1].split()
        disk_total, disk_used, disk_avail, disk_pct = disk_line[1], disk_line[2], disk_line[3], disk_line[4]

        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        status_text = (
            "<b>🖥️ Status VPS Debian:</b>\n\n"
            f"⏱️ <b>Uptime:</b> {uptime}\n"
            f"🧠 <b>RAM:</b> Terpakai {mem_used} / Total {mem_total} (Bebas: {mem_avail})\n"
            f"💾 <b>Disk (/):</b> Terpakai {disk_used} ({disk_pct}) / Total {disk_total} (Sisa: {disk_avail})\n"
            f"📂 <b>Shell Working Dir:</b> <code>{session_cwd}</code>\n\n"
            f"<i>Waktu Server: {now}</i>"
        )
        return status_text
    except Exception as e:
        return f"Gagal mengambil status VPS: {e}"

def autocomplete_path(query):
    query = query.strip()
    if not query:
        search_pattern = os.path.join(session_cwd, "*")
    elif query.startswith("/"):
        search_pattern = query + "*"
    else:
        search_pattern = os.path.join(session_cwd, query + "*")

    matches = glob.glob(search_pattern)
    matches.sort()
    
    if not matches:
        return "<i>Tidak ada file/folder yang cocok.</i>"

    output = f"<b>💡 Autocomplete / Suggestions ({len(matches)} hasil):</b>\n\n"
    for m in matches[:15]:
        is_dir = os.path.isdir(m)
        icon = "📁" if is_dir else "📄"
        rel_name = os.path.relpath(m, session_cwd) if m.startswith(session_cwd) else m
        if is_dir:
            cmd = f"cd {rel_name}"
            output += f"{icon} <code>{escape_html(rel_name)}/</code> ➔ Tap: <code>{escape_html(cmd)}</code>\n"
        else:
            cmd = f"cat {rel_name}"
            output += f"{icon} <code>{escape_html(rel_name)}</code> ➔ Tap: <code>/read {escape_html(rel_name)}</code>\n"
    return output

def execute_bash_command(cmd_str):
    global session_cwd
    
    cmd_str = cmd_str.strip()
    
    if cmd_str.startswith("cd ") or cmd_str == "cd":
        target = cmd_str[3:].strip() if len(cmd_str) > 2 else os.path.expanduser("~")
        if not target:
            target = os.path.expanduser("~")
        
        new_dir = os.path.abspath(os.path.join(session_cwd, target))
        if os.path.exists(new_dir) and os.path.isdir(new_dir):
            session_cwd = new_dir
            return True, f"Directory changed to: {session_cwd}"
        else:
            return False, f"Directory not found: {target}"

    try:
        proc = subprocess.run(
            cmd_str,
            shell=True,
            cwd=session_cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=30,
            executable="/bin/bash"
        )
        output = proc.stdout.decode("utf-8", errors="replace")
        if not output.strip():
            output = "(Command executed with no output - exit code 0)"
        return (proc.returncode == 0), output
    except subprocess.TimeoutExpired:
        return False, "Command timed out (exceeded 30 seconds limit)."
    except Exception as e:
        return False, f"Execution error: {e}"

def get_shell_keyboard():
    return {
        "keyboard": [
            [{"text": "ls -la"}, {"text": "pwd"}, {"text": "uptime"}],
            [{"text": "df -h"}, {"text": "free -h"}, {"text": "/tab"}],
            [{"text": "/status"}, {"text": "/logs"}, {"text": "/exit"}]
        ],
        "resize_keyboard": True,
        "is_persistent": True
    }

def handle_file_editor_command(text, bot_token, chat_id):
    global session_cwd

    text = text.strip()
    parts = text.split()
    cmd = parts[0].lower()

    if cmd in ["/read", "/cat"]:
        if len(parts) < 2:
            send_message(bot_token, chat_id, "Gunakan: <code>/read &lt;filepath&gt;</code>\nContoh: <code>/read /root/telegram-notifier/README.md</code>")
            return
        
        filepath = text[len(parts[0]):].strip()
        abs_path = os.path.abspath(os.path.join(session_cwd, filepath))

        if not os.path.exists(abs_path):
            send_message(bot_token, chat_id, f"❌ File tidak ditemukan: <code>{abs_path}</code>")
            return

        if os.path.isdir(abs_path):
            send_message(bot_token, chat_id, f"❌ Path ini adalah direktori/folder, gunakan <code>cd {filepath}</code> atau <code>/tab {filepath}</code>.")
            return

        size = os.path.getsize(abs_path)
        if size > 100000: # > 100 KB
            send_message(bot_token, chat_id, f"📄 File cukup besar ({size/1024:.1f} KB), mengunduh sebagai dokumen...")
            send_document(bot_token, chat_id, abs_path, caption=f"📄 {os.path.basename(abs_path)}")
            return

        try:
            with open(abs_path, "r", encoding="utf-8", errors="replace") as f:
                content = f.read()
            header = f"<b>📄 Reading File:</b> <code>{escape_html(abs_path)}</code> ({size} bytes)"
            send_chunked_output(bot_token, chat_id, header, content)
        except Exception as e:
            send_message(bot_token, chat_id, f"❌ Gagal membaca file: {e}")

    elif cmd == "/get" or cmd == "/download":
        if len(parts) < 2:
            send_message(bot_token, chat_id, "Gunakan: <code>/get &lt;filepath&gt;</code>\nContoh: <code>/get /root/telegram-notifier/README.md</code>")
            return

        filepath = text[len(parts[0]):].strip()
        abs_path = os.path.abspath(os.path.join(session_cwd, filepath))
        send_document(bot_token, chat_id, abs_path, caption=f"📄 {os.path.basename(abs_path)} | Path: {abs_path}")

    elif cmd == "/write":
        # Format: /write filepath
        # newline
        # content...
        lines = text.split("\n", 1)
        first_line = lines[0].strip().split()
        if len(first_line) < 2:
            send_message(bot_token, chat_id, "<b>Format Write File:</b>\n<code>/write &lt;filepath&gt;\n[isi file baru...]</code>\n\nAtau kirim/upload file dokumen ke bot ini dengan caption <code>/upload &lt;filepath&gt;</code>.")
            return

        filepath = first_line[1].strip()
        content = lines[1] if len(lines) > 1 else ""
        abs_path = os.path.abspath(os.path.join(session_cwd, filepath))

        try:
            parent_dir = os.path.dirname(abs_path)
            if parent_dir and not os.path.exists(parent_dir):
                os.makedirs(parent_dir, exist_ok=True)
                
            with open(abs_path, "w", encoding="utf-8") as f:
                f.write(content)
            send_message(bot_token, chat_id, f"✅ Berhasil menulis file ke <code>{abs_path}</code> ({len(content)} bytes).")
        except Exception as e:
            send_message(bot_token, chat_id, f"❌ Gagal menulis file: {e}")

    elif cmd == "/append":
        lines = text.split("\n", 1)
        first_line = lines[0].strip().split()
        if len(first_line) < 2:
            send_message(bot_token, chat_id, "<b>Format Append File:</b>\n<code>/append &lt;filepath&gt;\n[baris teks tambahan...]</code>")
            return

        filepath = first_line[1].strip()
        content = (lines[1] if len(lines) > 1 else "") + "\n"
        abs_path = os.path.abspath(os.path.join(session_cwd, filepath))

        try:
            with open(abs_path, "a", encoding="utf-8") as f:
                f.write(content)
            send_message(bot_token, chat_id, f"✅ Berhasil menambahkan baris ke <code>{abs_path}</code>.")
        except Exception as e:
            send_message(bot_token, chat_id, f"❌ Gagal append ke file: {e}")

def handle_command(text, bot_token, chat_id, document=None):
    global shell_mode, session_cwd

    # Handle document uploads first if document exists
    if document:
        file_id = document.get("file_id")
        file_name = document.get("file_name", "uploaded_file.txt")
        caption = (text or "").strip()

        if caption.startswith("/upload "):
            target_path = caption[8:].strip()
        elif caption.startswith("/write "):
            target_path = caption[7:].strip()
        elif caption:
            target_path = caption
        else:
            target_path = os.path.join(session_cwd, file_name)

        abs_path = os.path.abspath(os.path.join(session_cwd, target_path))
        send_message(bot_token, chat_id, f"📥 Mengunduh dan menyimpan file ke <code>{abs_path}</code>...")
        success, msg = download_telegram_file(bot_token, file_id, abs_path)
        icon = "✅" if success else "❌"
        send_message(bot_token, chat_id, f"{icon} {msg}")
        return

    text = text.strip()
    parts = text.split()
    first_word = parts[0].lower() if parts else ""

    if first_word in ["/start", "/help"]:
        shell_status = "🟢 AKTIF" if shell_mode else "🔴 NON-AKTIF"
        help_text = (
            "<b>🤖 Remote VPS Terminal & File Editor Bot</b>\n\n"
            "<b>📌 File Editor & Management:</b>\n"
            "• <code>/read &lt;file&gt;</code> — Baca/lihat isi file teks\n"
            "• <code>/get &lt;file&gt;</code> — Download file VPS sebagai dokumen ke Telegram\n"
            "• <code>/write &lt;file&gt;</code> + Newline + Isi file baru — Tulis/Overwrite file\n"
            "• <code>/append &lt;file&gt;</code> + Newline + Tambahan — Tambahkan baris ke file\n"
            "• <b>Upload File Dokumen:</b> Kirim file apa saja ke bot ini (isi caption dengan lokasi path tujuan) untuk overwrite file di VPS!\n\n"
            "<b>📌 Terminal Command:</b>\n"
            "• <code>/cmd &lt;command&gt;</code> — Jalankan perintah terminal\n"
            "• <code>/shell</code> — Mode Terminal Interaktif & Tombol Keyboard\n"
            "• <code>/tab &lt;query&gt;</code> — Autocomplete file & folder\n"
            "• <code>/cd &lt;folder&gt;</code> — Pindah direktori kerja\n"
            "• <code>/pwd</code> — Tampilkan direktori saat ini\n\n"
            "<b>📊 Monitoring & Log:</b>\n"
            "• <code>/logs</code> — Lihat log notifikasi VPS\n"
            "• <code>/status</code> — Cek RAM, Disk, Uptime VPS\n"
            "• <code>/ping</code> — Tes koneksi VPS\n\n"
            f"<i>Mode Shell: {shell_status} | CWD: {session_cwd}</i>"
        )
        send_message(bot_token, chat_id, help_text)

    elif first_word in ["/read", "/cat", "/get", "/download", "/write", "/append"]:
        handle_file_editor_command(text, bot_token, chat_id)

    elif first_word == "/shell":
        shell_mode = not shell_mode
        if shell_mode:
            msg = (
                "<b>🐚 MODE TERMINAL INTERAKTIF: AKTIF</b>\n\n"
                f"📂 <b>Direktori:</b> <code>{session_cwd}</code>\n\n"
                "• Ketik perintah terminal apa saja di chat ini.\n"
                "• Gunakan <b>Tombol Keyboard di bawah</b> untuk perintah cepat!\n"
                "• Gunakan <code>/read &lt;file&gt;</code> untuk baca file, atau <code>/get &lt;file&gt;</code> untuk download file.\n"
                "• Ketik <code>/exit</code> untuk mematikan mode ini."
            )
            send_message(bot_token, chat_id, msg, reply_markup=get_shell_keyboard())
        else:
            msg = "<b>🔴 MODE TERMINAL INTERAKTIF: NON-AKTIF</b>\nSistem kembali ke mode normal."
            send_message(bot_token, chat_id, msg, reply_markup={"remove_keyboard": True})

    elif first_word in ["/exit", "exit"] and shell_mode:
        shell_mode = False
        send_message(bot_token, chat_id, "<b>🔴 MODE TERMINAL INTERAKTIF: NON-AKTIF</b>", reply_markup={"remove_keyboard": True})

    elif first_word in ["/tab", "tab"]:
        query = text[len(parts[0]):].strip() if len(parts) > 1 else ""
        sug_text = autocomplete_path(query)
        send_message(bot_token, chat_id, sug_text)

    elif first_word in ["/cmd", "/sh", "/exec"]:
        if len(parts) < 2:
            send_message(bot_token, chat_id, "Gunakan format: <code>/cmd &lt;perintah_terminal&gt;</code>\nContoh: <code>/cmd systemctl status nginx</code>")
            return
        cmd_to_run = text[len(parts[0]):].strip()
        header = f"<b>🐚 Executing:</b> <code>{escape_html(cmd_to_run)}</code>\n📂 <b>CWD:</b> <code>{escape_html(session_cwd)}</code>"
        success, out = execute_bash_command(cmd_to_run)
        send_chunked_output(bot_token, chat_id, header, out)

    elif first_word == "/cd":
        target = text[3:].strip() if len(text) > 2 else ""
        cmd_to_run = f"cd {target}"
        success, out = execute_bash_command(cmd_to_run)
        icon = "✅" if success else "❌"
        send_message(bot_token, chat_id, f"{icon} {out}")

    elif first_word == "/pwd":
        send_message(bot_token, chat_id, f"📂 <b>Current Working Directory:</b> <code>{session_cwd}</code>")

    elif first_word in ["/logs", "/log"]:
        limit = 10
        if len(parts) > 1 and parts[1].isdigit():
            limit = min(int(parts[1]), 30)
        logs_text = get_logs(limit)
        send_message(bot_token, chat_id, logs_text)

    elif first_word == "/status":
        status_text = get_system_status()
        send_message(bot_token, chat_id, status_text)

    elif first_word == "/ping":
        send_message(bot_token, chat_id, "<b>Pong! ⚡</b>\nVPS Debian kamu aktif & berjalan normal.")

    else:
        if shell_mode:
            header = f"<b>🐚 Executing:</b> <code>{escape_html(text)}</code>\n📂 <b>CWD:</b> <code>{escape_html(session_cwd)}</code>"
            success, out = execute_bash_command(text)
            send_chunked_output(bot_token, chat_id, header, out)
        else:
            send_message(bot_token, chat_id, "Perintah tidak dikenali. Ketik <code>/cmd <command></code> atau aktifkan <code>/shell</code>. Gunakan <code>/help</code> untuk bantuan.")

def main():
    bot_token, owner_chat_id = load_config()

    if not bot_token or not owner_chat_id:
        print("Error: TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID is missing in config!", file=sys.stderr)
        sys.exit(1)

    print(f"Starting Telegram Bot Command Daemon for Chat ID {owner_chat_id}...")
    offset = 0

    while True:
        try:
            url = f"https://api.telegram.org/bot{bot_token}/getUpdates?offset={offset}&timeout=30"
            req = urllib.request.Request(url)
            with urllib.request.urlopen(req, timeout=35) as response:
                data = json.loads(response.read().decode("utf-8"))
                if data.get("ok"):
                    for update in data.get("result", []):
                        offset = update["update_id"] + 1
                        message = update.get("message", {})
                        from_id = str(message.get("from", {}).get("id", ""))
                        text = message.get("text", "") or message.get("caption", "")
                        document = message.get("document")

                        if from_id == str(owner_chat_id):
                            if text or document:
                                print(f"Received from owner ({from_id}): text={text}, doc={document is not None}")
                                handle_command(text, bot_token, owner_chat_id, document=document)
        except urllib.error.URLError:
            time.sleep(5)
        except Exception as e:
            print(f"Error in long polling loop: {e}", file=sys.stderr)
            time.sleep(5)

if __name__ == "__main__":
    main()
